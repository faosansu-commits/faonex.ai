# คัดลอกไฟล์นี้เป็น .env แล้วปรับค่าตามต้องการ
# ชื่อโมเดล Ollama สำหรับแชททั่วไป (ดูรายชื่อโมเดลได้ที่ https://ollama.com/library)
OLLAMA_MODEL=llama3.2

# ชื่อโมเดล Ollama สำหรับโหมด "เขียนโค้ด" (โมเดลเฉพาะทางด้านโปรแกรมมิ่ง)
OLLAMA_CODE_MODEL=qwen2.5-coder:3b

# ชื่อโมเดล Ollama สำหรับดูรูปภาพที่ผู้ใช้แนบมา (ดาวน์โหลดอัตโนมัติตอนมีคนแนบรูปครั้งแรก)
OLLAMA_VISION_MODEL=llava-phi3

# ชื่อโมเดล Ollama สำหรับทำ embedding ค้นหาข้อมูลในเอกสาร PDF ที่แอดมินอัปโหลด (ระบบ RAG + Rule)
# ดาวน์โหลดอัตโนมัติตอนอัปโหลดเอกสาร/ถามคำถามที่ตรงหัวข้อครั้งแรก
OLLAMA_EMBED_MODEL=nomic-embed-text

# ความเข้มงวดของระบบ RAG: จำนวนส่วนเนื้อหาสูงสุดที่ดึงมาอ้างอิงต่อคำถาม และค่าความใกล้เคียงขั้นต่ำ (0-1 ยิ่งสูงยิ่งเข้มงวด)
APP_RAG_TOP_K=4
APP_RAG_SIMILARITY_THRESHOLD=0.35

# ชื่อองค์กร แสดงบนหน้าเว็บและใช้ประกอบ system prompt
APP_ORG_NAME=องค์กรของเรา

# เวลาที่รอคำตอบจาก Ollama สูงสุด (วินาที) - เพิ่มไว้เผื่อรันบน CPU ที่ไม่มี GPU
OLLAMA_TIMEOUT=120

# เวลาที่รอคำตอบแบบ streaming สูงสุด (วินาที) - แยกจากด้านบนเพราะคำตอบยาวๆ บน CPU อาจใช้เวลานานหลายนาที
# แต่ผู้ใช้เห็นคำตอบทยอยออกมาระหว่างรอได้อยู่แล้ว จึงตั้งไว้นานกว่าได้อย่างปลอดภัย
OLLAMA_STREAM_TIMEOUT=600

# ขนาด context window ที่ส่งให้ Ollama ต่อคำขอ (ยิ่งมากยิ่งจำบทสนทนา/ไฟล์แนบยาวๆ ได้ แต่ใช้ RAM/CPU มากขึ้น)
OLLAMA_NUM_CTX=8192

# จำนวน token สูงสุดที่ให้ AI ตอบต่อครั้ง ใส่ -1 = ไม่จำกัด (ตอบยาวได้เต็มที่ จนกว่าจะจบเองหรือเต็ม context)
OLLAMA_NUM_PREDICT=-1

# โควตาเริ่มต้นต่อผู้ใช้ 1 คนต่อวัน (แอดมินตั้งค่าเฉพาะรายคนทับค่านี้ได้ในหน้าจัดการผู้ใช้)
# ใส่ 0 = ไม่จำกัด
APP_DEFAULT_DAILY_REQUEST_LIMIT=100
APP_DEFAULT_DAILY_TOKEN_LIMIT=20000

# ฐานข้อมูล MySQL/MariaDB (รองรับผู้ใช้งานพร้อมกันได้มาก เหมาะสำหรับผู้ใช้ ~2000 คน)
# แก้รหัสผ่านเหล่านี้ก่อนใช้งานจริงเสมอ โดยเฉพาะบนเซิร์ฟเวอร์ที่เข้าถึงได้จากภายนอก
DB_NAME=faonex
DB_USER=faonex
DB_PASSWORD=faonex_change_me
DB_ROOT_PASSWORD=faonex_root_change_me
